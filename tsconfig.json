{
  "compilerOptions": {
  "target": "esnext",
  "module": "esnext",
  "jsx": "react-native",
  "strict": true,
  "allowSyntheticDefaultImports": true,
  "esModuleInterop": true,
  "skipLibCheck": true,
  "forceConsistentCasingInFileNames": true
  },
  "include": [
    "app",
    "components",
    "lib",
    "global.d.ts"
  ],
  "exclude": [
    "node_modules"
  ],
  "extends": "expo/tsconfig.base"
}
